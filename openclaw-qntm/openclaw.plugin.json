{
  "id": "qntm",
  "contracts": {
    "tools": [
      "qntm_gateway"
    ]
  },
  "toolMetadata": {
    "qntm_gateway": {
      "optional": true
    }
  },
  "channels": [
    "qntm"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "qntm": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "relayUrl": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "identityFile": {
            "type": "string"
          },
          "identityDir": {
            "type": "string"
          },
          "defaultTo": {
            "type": "string"
          },
          "conversations": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "invite": {
                  "type": "string"
                },
                "gatewayActions": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "invite",
                      "request",
                      "approve",
                      "disapprove",
                      "secret",
                      "propose",
                      "gov-approve",
                      "gov-disapprove"
                    ]
                  }
                },
                "convId": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string",
                  "enum": [
                    "all",
                    "mention"
                  ]
                },
                "triggerNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "accounts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "relayUrl": {
                  "type": "string"
                },
                "identity": {
                  "type": "string"
                },
                "identityFile": {
                  "type": "string"
                },
                "identityDir": {
                  "type": "string"
                },
                "defaultTo": {
                  "type": "string"
                },
                "conversations": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "enabled": {
                        "type": "boolean"
                      },
                      "invite": {
                        "type": "string"
                      },
                      "gatewayActions": {
                        "maxItems": 8,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "invite",
                            "request",
                            "approve",
                            "disapprove",
                            "secret",
                            "propose",
                            "gov-approve",
                            "gov-disapprove"
                          ]
                        }
                      },
                      "convId": {
                        "type": "string"
                      },
                      "trigger": {
                        "type": "string",
                        "enum": [
                          "all",
                          "mention"
                        ]
                      },
                      "triggerNames": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "defaultAccount": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uiHints": {
        "identity": {
          "sensitive": true,
          "help": "Private signing identity. Prefer identityFile or identityDir."
        },
        "conversations.*.invite": {
          "sensitive": true,
          "help": "Contains conversation encryption keys."
        },
        "conversations.*.gatewayActions": {
          "help": "Optional native gateway tool permissions for this conversation. Empty disables all actions. Also allow qntm_gateway in the host tool policy."
        },
        "accounts.*.identity": {
          "sensitive": true,
          "help": "Private signing identity. Prefer identityFile or identityDir."
        },
        "accounts.*.conversations.*.invite": {
          "sensitive": true,
          "help": "Contains conversation encryption keys."
        },
        "accounts.*.conversations.*.gatewayActions": {
          "help": "Optional native gateway tool permissions for this conversation. Empty disables all actions. Also allow qntm_gateway in the host tool policy."
        }
      }
    }
  }
}
