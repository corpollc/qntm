{
  "id": "qntm",
  "contracts": {
    "tools": [
      "qntm_gateway",
      "qntm_group"
    ]
  },
  "toolMetadata": {
    "qntm_gateway": {
      "optional": true
    },
    "qntm_group": {
      "optional": true
    }
  },
  "channels": [
    "qntm"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "qntm": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "relayUrl": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "identityFile": {
            "type": "string"
          },
          "identityDir": {
            "type": "string"
          },
          "defaultTo": {
            "type": "string"
          },
          "contacts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^(?:[0-9a-fA-F]{64}|[A-Za-z0-9_-]{43})$"
            }
          },
          "conversations": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "invite": {
                  "type": "string"
                },
                "groupLink": {
                  "type": "string",
                  "maxLength": 8192
                },
                "groupActions": {
                  "maxItems": 7,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "add",
                      "remove",
                      "refresh",
                      "rekey",
                      "retry",
                      "open",
                      "send"
                    ]
                  }
                },
                "gatewayActions": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "invite",
                      "request",
                      "approve",
                      "disapprove",
                      "secret",
                      "propose",
                      "gov-approve",
                      "gov-disapprove"
                    ]
                  }
                },
                "convId": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string",
                  "enum": [
                    "all",
                    "mention"
                  ]
                },
                "triggerNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "accounts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "relayUrl": {
                  "type": "string"
                },
                "identity": {
                  "type": "string"
                },
                "identityFile": {
                  "type": "string"
                },
                "identityDir": {
                  "type": "string"
                },
                "defaultTo": {
                  "type": "string"
                },
                "contacts": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-fA-F]{64}|[A-Za-z0-9_-]{43})$"
                  }
                },
                "conversations": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "enabled": {
                        "type": "boolean"
                      },
                      "invite": {
                        "type": "string"
                      },
                      "groupLink": {
                        "type": "string",
                        "maxLength": 8192
                      },
                      "groupActions": {
                        "maxItems": 7,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "add",
                            "remove",
                            "refresh",
                            "rekey",
                            "retry",
                            "open",
                            "send"
                          ]
                        }
                      },
                      "gatewayActions": {
                        "maxItems": 8,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "invite",
                            "request",
                            "approve",
                            "disapprove",
                            "secret",
                            "propose",
                            "gov-approve",
                            "gov-disapprove"
                          ]
                        }
                      },
                      "convId": {
                        "type": "string"
                      },
                      "trigger": {
                        "type": "string",
                        "enum": [
                          "all",
                          "mention"
                        ]
                      },
                      "triggerNames": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "defaultAccount": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uiHints": {
        "identity": {
          "sensitive": true,
          "help": "Private signing identity. Prefer identityFile or identityDir."
        },
        "conversations.*.invite": {
          "sensitive": true,
          "help": "Contains conversation encryption keys."
        },
        "contacts": {
          "help": "Locally verified full Ed25519 public keys keyed by contact name. Incoming messages cannot create or replace pins."
        },
        "conversations.*.groupLink": {
          "help": "Public key-free locator from a configured contact. Configuring this link authorizes fetching its encrypted welcome from the configured relay."
        },
        "conversations.*.groupActions": {
          "help": "Optional reviewed ordinary-group actions; also allow qntm_group in host tool policy. Empty disables the tool."
        },
        "conversations.*.gatewayActions": {
          "help": "Optional native gateway tool permissions for this conversation. Empty disables all actions. Also allow qntm_gateway in the host tool policy."
        },
        "accounts.*.identity": {
          "sensitive": true,
          "help": "Private signing identity. Prefer identityFile or identityDir."
        },
        "accounts.*.conversations.*.invite": {
          "sensitive": true,
          "help": "Contains conversation encryption keys."
        },
        "accounts.*.contacts": {
          "help": "Locally verified full Ed25519 public keys keyed by contact name. Incoming messages cannot create or replace pins."
        },
        "accounts.*.conversations.*.groupLink": {
          "help": "Public key-free locator from a configured contact. Configuring this link authorizes fetching its encrypted welcome from the configured relay."
        },
        "accounts.*.conversations.*.groupActions": {
          "help": "Optional reviewed ordinary-group actions; also allow qntm_group in host tool policy. Empty disables the tool."
        },
        "accounts.*.conversations.*.gatewayActions": {
          "help": "Optional native gateway tool permissions for this conversation. Empty disables all actions. Also allow qntm_gateway in the host tool policy."
        }
      }
    }
  }
}
